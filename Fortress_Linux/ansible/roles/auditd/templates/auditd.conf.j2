# QoS depth
qos_depth = {{ auditd_qos_depth | default('400') }}

# Priority boost
priority_boost = {{ auditd_priority_boost }}

# Failure mode
failure_mode = {{ auditd_failure_mode }}

# Buffer size
buffer_size = {{ auditd_buffer_size }}

# Rate limit
