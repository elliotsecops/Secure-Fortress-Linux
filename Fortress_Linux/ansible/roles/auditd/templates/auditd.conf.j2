log_file = {{ auditd_log_file }}
log_format = {{ auditd_log_format }}
log_group = root

# Local events
local_events = yes

# Write logs to disk
write_logs = yes

# Flush method
flush = {{ auditd_flush }}

# Frequency for incremental flush
freq = {{ auditd_freq }}

# Number of logs to keep
num_logs = {{ auditd_num_logs }}

# Maximum log file size in MB
max_log_file = {{ auditd_max_log_file }}

# Action when max file size reached
max_log_file_action = {{ auditd_max_log_file_action }}

# Space left action
space_left = {{ auditd_space_left }}
space_left_action = {{ auditd_space_left_action }}

# Admin space left action
admin_space_left = {{ auditd_admin_space_left }}
admin_space_left_action = {{ auditd_admin_space_left_action }}

# Disk full action
disk_full_action = {{ auditd_disk_full_action | default('SYSLOG') }}

# Disk error action
disk_error_action = {{ auditd_disk_error_action | default('SYSLOG') }}

# TCP queue size
tcp_listen_queue = {{ auditd_tcp_listen_queue | default('5') }}

# TCP max pending connections
tcp_max_per_addr = {{ auditd_tcp_max_per_addr | default('1') }}

# Use libwrap for TCP connections
use_libwrap = {{ auditd_use_libwrap | default('yes') }}

# TCP client ports
tcp_client_ports = {{ auditd_tcp_client_ports | default('1024-65535') }}

# TCP client max idle time
tcp_client_max_idle = {{ auditd_tcp_client_max_idle | default('0') }}

# Transport protocol
transport = {{ auditd_transport | default('TCP') }}

# Network failure action
network_failure_action = {{ auditd_network_failure_action | default('STOP') }}

# Enable kaudit
enable_krb5 = {{ auditd_enable_krb5 | default('no') }}
