#
# /etc/logrotate.d/auditd
# Generated by Ansible - Fortress Linux
#

/var/log/audit/audit.log {
    daily
    rotate {{ auditd_num_logs }}
    missingok
    notifempty
    compress
    delaycompress
    postrotate
        /usr/sbin/augenrules --load > /dev/null 2>&1 || true
    endscript
    sharedscripts
    create 0600 root root
}