#
# /etc/audit/rules.d/audit.rules
# Generated by Ansible - Fortress Linux
#

# First rule - delete all
-D

# Increase the buffers to survive stress events.
# Make this bigger for busy systems
-b {{ auditd_buffer_size }}

# No failure mode
-f {{ auditd_failure_mode }}

# Set audit rate limit
-r {{ auditd_audit_rate_limit }}

# Set backlog limit
--backlog_limit={{ auditd_audit_backlog_limit }}

# Set backlog wait time
--backlog_wait_time={{ auditd_audit_backlog_wait_time }}

# Audit the audit logs
-w /var/log/audit/ -p wa -k audit

# Audit the audit configuration
-w /etc/audit/ -p wa -k audit

# Audit login and logout events
-w /var/log/auth.log -p wa -k auth
-w /var/log/secure -p wa -k auth
-w /var/log/faillog -p wa -k logins
-w /var/log/lastlog -p wa -k logins
-w /var/run/utmp -p wa -k session
-w /var/log/wtmp -p wa -k logins
-w /var/log/btmp -p wa -k session

# Audit sudo usage
-w /var/log/sudo.log -p wa -k sudo
-w /etc/sudoers -p wa -k sudo
-w /etc/sudoers.d/ -p wa -k sudo

# Audit password and group files
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity

# Audit system configuration files
-w /etc/hosts -p wa -k system_info
-w /etc/sysconfig/network -p wa -k network
-w /etc/resolv.conf -p wa -k network
-w /etc/issue -p wa -k system_info
-w /etc/issue.net -p wa -k system_info

# Audit time changes
-a always,exit -F arch=b64 -S adjtimex -F auid>=1000 -F auid!=-1 -k time-change
-a always,exit -F arch=b64 -S settimeofday -F auid>=1000 -F auid!=-1 -k time-change
-a always,exit -F arch=b64 -S clock_settime -F auid>=1000 -F auid!=-1 -k time-change

# Audit user/group changes
-w /etc/group -p wa -k identity
-w /etc/passwd -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity

# Audit network configuration
-w /etc/hosts -p wa -k system_info
-w /etc/sysconfig/network -p wa -k network
-w /etc/resolv.conf -p wa -k network

# Audit cron configuration
-w /etc/cron.allow -p wa -k cron
-w /etc/cron.deny -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/crontab -p wa -k cron
-w /var/spool/cron/crontabs/ -p wa -k cron

# Audit login and logout events
-w /var/log/auth.log -p wa -k auth
-w /var/log/secure -p wa -k auth
-w /var/log/faillog -p wa -k logins
-w /var/log/lastlog -p wa -k logins
-w /var/run/utmp -p wa -k session
-w /var/log/wtmp -p wa -k logins
-w /var/log/btmp -p wa -k session

# Audit sudo usage
-w /var/log/sudo.log -p wa -k sudo
-w /etc/sudoers -p wa -k sudo
-w /etc/sudoers.d/ -p wa -k sudo

# Audit system calls for file access
-a always,exit -F arch=b64 -S open,creat,truncate,ftruncate,openat,open_by_handle_at -F exit=-EACCES -F auid>=1000 -F auid!=-1 -k access
