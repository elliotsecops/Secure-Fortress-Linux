#

[fortress_linux]
# Example target hosts (uncomment and modify as needed)
# 192.168.1.10 ansible_user=ansible
# 192.168.1.11 ansible_user=ansible
# server1.example.com ansible_user=ansible

# For localhost testing only (not recommended for production)
# localhost ansible_connection=local

# Production servers
# production_srv[1:5].example.com ansible_user=ansible

# Development servers  
# dev_srv[1:3].example.com ansible_user=ansible

# DMZ servers (special security requirements)
# dmz_srv[1:2].example.com ansible_user=ansible

# Group variables for fortress_linux group (if needed)
[fortress_linux:vars]
